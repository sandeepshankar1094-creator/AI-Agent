# Stage 1: Build Angular application
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build


# Stage 2: Serve using Nginx
FROM nginx:alpine

COPY --from=build /app/{{ANGULAR_OUTPUT_PATH}} /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]